--- a/src/java/org/lwjgl/util/generator/GeneratorVisitor.java
+++ b/src/java/org/lwjgl/util/generator/GeneratorVisitor.java
@@ -299,8 +299,16 @@ public class GeneratorVisitor extends ElementKindVisitor6<Void, Void> {
 				validateMethod(method);
 			}
 
-			// TODO: Back-port LWJGL 3's generation file handling (generate in-memory and avoid touching files if nothing has changed)
-			java_writer = new PrintWriter(env.getFiler().createSourceFile(Utils.getQualifiedClassName(e), env.getElementUtils().getPackageOf(e)).openWriter());
+			// LOCAL OHOS-PORT PATCH (Meowcraft, tools/lwjgl2): write the generated Java file straight to
+			// disk instead of env.getFiler().createSourceFile(...). On JDK 9+ JavacFiler refuses to create
+			// a source file whose type name already exists among the compilation inputs, and the core
+			// templates declare exactly the FQN they generate (templates/org/lwjgl/opengl/GL14.java declares
+			// org.lwjgl.opengl.GL14) -> "Attempt to recreate a file for type org.lwjgl.opengl.GL14".
+			// Upstream ran on JDK 6/7, before that check existed. We drive the processor with -proc:only and
+			// compile the generated sources in a separate javac pass, so bypassing the Filer is safe.
+			final File outDir = outputJava.getParentFile();
+			if ( outDir != null && !outDir.exists() ) outDir.mkdirs();
+			java_writer = new PrintWriter(outputJava, "UTF-8");
 			generateJavaSource(e, java_writer);
 
